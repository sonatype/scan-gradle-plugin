@Library(['private-pipeline-library', 'jenkins-shared', 'int-jenkins-shared']) _

def imageName = 'integrations/gradle-build-pipeline'
def registry = sonatypeDockerRegistryId()

dockerizedBuildPipeline(
  deployBranch: 'main',
  buildAndTest: {
    // This will run a couple of commands to ensure the image is being built properly
    sh '''
      java --version
      groovy --version
    '''
  },
  skipVulnerabilityScan: true,
  deploy: {
    withSonatypeDockerRegistry() {
      sh "echo 'Image is being tagged and pushed'"
      sh """docker tag $DOCKER_IMAGE_ID ${registry}/${imageName}:latest
            docker push ${registry}/${imageName}:latest
            docker rmi ${registry}/${imageName}:latest"""
      sh "echo 'Image is tagged and pushed successfully'"
    }
  },
  onSuccess: {
    buildNotifications(currentBuild, env, 'main')
  },
  onFailure: {
    buildNotifications(currentBuild, env, 'main')
  }
)
